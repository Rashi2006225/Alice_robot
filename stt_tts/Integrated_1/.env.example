# --- Groq (STT + chat) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Whisper model for /transcribe — matches STT_MODEL in the Python config.py
STT_MODEL=whisper-large-v3-turbo
# ISO-639-1 code, e.g. "en" or "hi" — leave blank to let Whisper auto-detect
STT_LANGUAGE=en

# --- ElevenLabs (TTS) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Default voice = George, default model = eleven_flash_v2_5 (same as tts_config.py)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

PORT=3001
